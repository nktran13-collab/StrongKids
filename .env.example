# Supabase → Project Settings → API
# Dán vào .env.local khi chạy máy, và vào Vercel → Settings → Environment Variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Dùng anon key (eyJ...) hoặc publishable key (sb_publishable_...) đều được.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
